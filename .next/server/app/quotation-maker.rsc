5:T9d3,[{"@context":"https://schema.org","@type":"SoftwareApplication","name":"InvoiceWala Quotation Generator","applicationCategory":"BusinessApplication","operatingSystem":"Web","url":"https://invoicewala.shop/quotation-maker","offers":{"@type":"Offer","price":"0","priceCurrency":"INR"}},{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What is a quotation generator?","acceptedAnswer":{"@type":"Answer","text":"A quotation generator creates professional price quotes with business details, customer details, item rows, GST, discount, validity and terms."}},{"@type":"Question","name":"Can I create a quotation online for free?","acceptedAnswer":{"@type":"Answer","text":"Yes. InvoiceWala lets you create a quotation, review the live preview and download a PDF without saving it to a database."}},{"@type":"Question","name":"What should an Indian quotation include?","acceptedAnswer":{"@type":"Answer","text":"Include quotation number, date, validity, seller and customer details, item description, quantity, rate, tax, discount, total and terms."}},{"@type":"Question","name":"Is a quotation the same as an invoice?","acceptedAnswer":{"@type":"Answer","text":"No. A quotation shares proposed prices before approval. An invoice requests payment after goods or services are supplied."}},{"@type":"Question","name":"Can I add GST to a quotation?","acceptedAnswer":{"@type":"Answer","text":"Yes. Add GSTIN and tax rates when your proposed pricing needs a GST breakdown."}},{"@type":"Question","name":"Can I download the quotation as PDF?","acceptedAnswer":{"@type":"Answer","text":"Yes. The generated quotation can be downloaded as a clean PDF and shared by WhatsApp or email."}},{"@type":"Question","name":"Who can use this quotation maker?","acceptedAnswer":{"@type":"Answer","text":"Freelancers, contractors, agencies, consultants, repair businesses, traders and small Indian businesses can use it."}},{"@type":"Question","name":"Does a quotation need a validity date?","acceptedAnswer":{"@type":"Answer","text":"A validity date is recommended because prices, availability and project timelines can change."}}]},{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://invoicewala.shop"},{"@type":"ListItem","position":2,"name":"Tools","item":"https://invoicewala.shop/tools"},{"@type":"ListItem","position":3,"name":"Quotation Generator","item":"https://invoicewala.shop/quotation-maker"}]}]0:{"P":null,"c":["","quotation-maker"],"q":"","i":false,"f":[[["",{"children":["quotation-maker",{"children":["__PAGE__",{}]}]},"$undefined","$undefined",16],[["$","$1","c",{"children":[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/chunks/025vt89l4s0qw.css","precedence":"next","crossOrigin":"$undefined","nonce":"$undefined"}],["$","script","script-0",{"src":"/_next/static/chunks/0g65zv~fun4x7.js","async":true,"nonce":"$undefined"}],["$","script","script-1",{"src":"/_next/static/chunks/0d3shmwh5_nmn.js","async":true,"nonce":"$undefined"}]],["$","html",null,{"lang":"en","className":"h-full antialiased","children":["$","body",null,{"className":"min-h-full bg-slate-50 text-slate-950 antialiased dark:bg-slate-950 dark:text-slate-50","children":[["$","$L2",null,{"src":"https://www.googletagmanager.com/gtag/js?id=G-WVY8QGQWCV","strategy":"afterInteractive"}],["$","$L2",null,{"id":"google-analytics","strategy":"afterInteractive","children":"\n            window.dataLayer = window.dataLayer || [];\n            function gtag(){dataLayer.push(arguments);}\n            gtag('js', new Date());\n            gtag('config', 'G-WVY8QGQWCV');\n          "}],["$","$L3",null,{"parallelRouterKey":"children","error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L4",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":[[["$","title",null,{"children":"404: This page could not be found."}],["$","div