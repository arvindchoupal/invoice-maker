{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/[seoSlug]/layout,_N_T_/[seoSlug]/page,_N_T_/freelancer-invoice-template"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/$d$seoSlug/__PAGE__",
    "/$d$seoSlug",
    "/_index",
    "/_head"
  ]
}