24:["$","p","21",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"The header should include your freelance brand or legal name. If you use a business name, add it clearly. You may also add your logo, phone number, email and address. A branded header makes your invoice look more professional."}]]}]
