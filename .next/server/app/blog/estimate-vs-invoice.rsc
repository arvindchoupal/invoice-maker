5b:["$","h2","79",{"className":"mt-10 text-2xl font-semibold text-white","children":"Frequently Asked Questions"}]
5c:["$","h3","80",{"className":"mt-8 text-xl font-semibold text-white","children":"What is the difference between estimate and invoice?"}]
5d:["$","p","81",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"An estimate shows expected pricing before work starts. An invoice requests payment after work is completed, goods are delivered or a billing milestone is reached."}]]}]
5e:["$","h3","82",{"className":"mt-8 text-xl font-semibold text-white","children":"Is an estimate legally binding?"}]
5f:["$","p","83",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"An estimate is usually not legally binding unless both parties agree to specific terms. It is generally a pricing approximation, not a final payment demand."}]]}]
60:["$","h3","84",{"className":"mt-8 text-xl font-semibold text-white","children":"Can an estimate become an invoice?"}]
61:["$","p","85",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Yes. After customer approval and work completion, an estimate can be converted into an invoice by updating final amounts, adding invoice number, due date and payment terms."}]]}]
62:["$","h3","86",{"className":"mt-8 text-xl font-semibold text-white","children":"Do estimates need GST?"}]
63:["$","p","87",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Estimates can show expected GST when applicable, but they are not the same as GST tax invoices. GST should be properly shown on the final invoice if required."}]]}]
64:["$","h3","88",{"className":"mt-8 text-xl font-semibold text-white","children":"Can I send estimates online?"}]
65:["$","p","89",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Yes. Online estimates are useful because they can be shared as PDFs or links and then converted into invoices later."}]]}]
66:["$","h3","90",{"className":"mt-8 text-xl font-semibold text-white","children":"What should an estimate include?"}]
67:["$","p","91",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"An estimate should include customer details, scope, item descriptions, labor, materials, estimated tax, estimated total, validity period and important terms."}]]}]
68:["$","h3","92",{"className":"mt-8 text-xl font-semibold text-white","children":"Can I edit an estimate after sending?"}]
69:["$","p","93",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Yes. Estimates can be revised before approval when scope, quantities, materials or pricing changes."}]]}]
6a:["$","h3","94",{"className":"mt-8 text-xl font-semibold text-white","children":"Should estimates have numbers?"}]
6b:["$","p","95",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Yes. Estimate numbers help track customer requests, approvals and conversions into invoices."}]]}]
6c:["$","h3","96",{"className":"mt-8 text-xl font-semibold text-white","children":"Can contractors use estimates?"}]
6d:["$","p","97",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Yes. Contractors often use estimates for renovation, construction, repair, maintenance, labor and material jobs."}]]}]
6e:["$","h3","98",{"className":"mt-8 text-xl font-semibold text-white","children":"Can freelancers send estimates?"}]
6f:["$","p","99",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Yes. Freelancers can send estimates before website projects, design projects, consulting work, content work or marketing services."}]]}]
70:["$","h3","100",{"className":"mt-8 text-xl font-semibold text-white","children":"What is the difference between quotation and estimate?"}]
71:["$","p","101",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"A quotation is usually more fixed and formal. An estimate is more approximate and may change after inspection or final scope confirmation."}]]}]
72:["$","h3","102",{"className":"mt-8 text-xl font-semibold text-white","children":"What is the difference between quotation and invoice?"}]
73:["$","p","103",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"A quotation offers a price before approval. An invoice asks for payment after delivery, completion or an agreed billing milestone."}]]}]
74:["$","h3","104",{"className":"mt-8 text-xl font-semibold text-white","children":"Can I download estimate PDFs?"}]
75:["$","p","105",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Yes. A modern estimate generator should let you create an estimate and download it as a professional PDF."}]]}]
76:["$","h3","106",{"className":"mt-8 text-xl font-semibold text-white","children":"Can I convert estimates into invoices?"}]
77:["$","p","107",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Yes. Once an estimate is approved, convert it into an invoice by confirming the final scope, adding a unique invoice number, setting the due date and adding payment terms."}]]}]
78:["$","h3","108",{"className":"mt-8 text-xl font-semibold text-white","children":"How do I track approved estimates?"}]
79:["$","p","109",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Track estimate statuses such as draft, sent, approved, rejected and converted. Once approved, convert the estimate into an invoice."}]]}]
7a:["$","h3","110",{"className":"mt-8 text-xl font-semibold text-white","children":"Do invoices require unique invoice numbers?"}]
