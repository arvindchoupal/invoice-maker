18:["$","p","12",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"An estimate is a document that shows the expected cost of a product, service, repair, project or custom job. It is not normally a payment request. It is sent before the customer confirms the work so they can understand the likely budget."}]]}]
19:["$","p","13",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Estimates are useful when the final amount is not fully fixed at the start. A contractor may not know the exact material quantity before work begins, and a repair technician may need to inspect the issue before confirming the final cost."}]]}]
1a:["$","p","14",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"An estimate should include scope of work, expected labor, material cost, tax if applicable, estimated total and validity period. It can also include notes such as “final invoice may change based on actual material used”."}]]}]
