":"Needed before work"}]]}],["$","td","2",{"className":"px-4 py-3 text-slate-300","children":[["$","span","0",{"children":"Needed before order/work"}]]}]]}],["$","tr","| Can change later? | Usually yes | Less often |",{"className":"border-b border-white/10 last:border-0","children":[["$","td","0",{"className":"px-4 py-3 text-slate-300","children":[["$","span","0",{"children":"Can change later?"}]]}],["$","td","1",{"className":"px-4 py-3 text-slate-300","children":[["$","span","0",{"children":"Usually yes"}]]}],["$","td","2",{"className":"px-4 py-3 text-slate-300","children":[["$","span","0",{"children":"Less often"}]]}]]}],["$","tr","| Example | Repair estimate after inspection | Fixed price quotation for 50 chairs |",{"className":"border-b border-white/10 last:border-0","children":[["$","td","0",{"className":"px-4 py-3 text-slate-300","children":[["$","span","0",{"children":"Example"}]]}],["$","td","1",{"className":"px-4 py-3 text-slate-300","children":[["$","span","0",{"children":"Repair estimate after inspection"}]]}],["$","td","2",{"className":"px-4 py-3 text-slate-300","children":[["$","span","0",{"children":"Fixed price quotation for 50 chairs"}]]}]]}]]}]}]}]
41:["$","p","53",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Use an estimate when work depends on inspection or actual effort. Use a quotation when the scope and price are clear enough for a fixed commercial proposal."}]]}]
42:["$","h2","54",{"className":"mt-10 text-2xl font-semibold text-white","children":"Quotation vs Invoice"}]
43:["$","p","55",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Quotation vs invoice is easier to understand. A quotation is sent before the sale or work is approved. An invoice is sent after the sale, delivery, completion or milestone."}]]}]
