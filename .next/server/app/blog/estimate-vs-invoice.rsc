50:["$","h2","68",{"className":"mt-10 text-2xl font-semibold text-white","children":"Common Mistakes Businesses Make"}]
51:["$","ul","69",{"className":"mt-4 list-disc space-y-2 pl-6 text-slate-300","children":[["$","li","Sending invoices before approval: This can make customers feel billed before they agreed to the job.",{"children":[["$","span","0",{"children":"Sending invoices before approval: This can make customers feel billed before they agreed to the job."}]]}],["$","li","Missing estimate details: A vague estimate creates disputes later when final pricing changes.",{"children":[["$","span","0",{"children":"Missing estimate details: A vague estimate creates disputes later when final pricing changes."}]]}],["$","li","No invoice numbering: Without unique invoice numbers, payment tracking and bookkeeping become messy.",{"children":[["$","span","0",{"children":"No invoice numbering: Without unique invoice numbers, payment tracking and bookkeeping become messy."}]]}],["$","li","Unclear payment terms: Customers should know due date, payment method and late payment expectations.",{"children":[["$","span","0",{"children":"Unclear payment terms: Customers should know due date, payment method and late payment expectations."}]]}],["$","li","Converting estimates incorrectly: If scope changes, update the invoice instead of copying old estimate values blindly.",{"children":[["$","span","0",{"children":"Converting estimates incorrectly: If scope changes, update the invoice instead of copying old estimate values blindly."}]]}],["$","li","Not mentioning validity: Estimates should say how long the pricing is valid.",{"children":[["$","span","0",{"children":"Not mentioning validity: Estimates should say how long the pricing is valid."}]]}],["$","li","Using Excel without control: Manual templates can lead to duplicate numbers, broken formulas and formatting issues.",{"children":[["$","span","0",{"children":"Using Excel without control: Manual templates can lead to duplicate numbers, broken formulas and formatting issues."}]]}]]}]
