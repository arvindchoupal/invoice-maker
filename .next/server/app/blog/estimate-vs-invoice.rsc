3a:["$","h3","46",{"className":"mt-8 text-xl font-semibold text-white","children":"Electrician Estimate vs Invoice"}]
3b:["$","p","47",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"An electrician visits a home to inspect wiring repair. Before starting, the electrician sends an estimate with labor cost, wire cost, switchboard material and GST if applicable. After completing the work, the electrician sends an invoice with actual material used, GST and payment due date."}]]}]
3c:["$","h3","48",{"className":"mt-8 text-xl font-semibold text-white","children":"Plumber Estimate vs Invoice"}]
3d:["$","p","49",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"A plumber may send an estimate after checking leakage, pipe replacement or bathroom fitting work. The estimate may include labor, PVC/CPVC pipes, taps, valves and visit charges. After the repair is done, the plumber sends an invoice with actual material used and final payment due."}]]}]
3e:["$","h2","50",{"className":"mt-10 text-2xl font-semibold text-white","children":"Estimate vs Quotation"}]
3f:["$","p","51",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"People often compare estimate vs quotation because both are sent before work begins. A quotation is usually more formal and fixed, while an estimate is more flexible."}]]}]
