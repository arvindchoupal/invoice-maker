34:["$","p","46",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Agencies often bill retainers, campaigns, creative work, ad management, SEO, web development or design services. Their invoice template should support project summaries and recurring monthly charges."}]]}]
