3b:["$","h2","55",{"className":"mt-10 text-2xl font-semibold text-white","children":"Frequently Asked Questions"}]
3c:["$","h3","56",{"className":"mt-8 text-xl font-semibold text-white","children":"What is CGST?"}]
3d:["$","p","57",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"CGST is Central Goods and Services Tax. It is generally charged with SGST for intra-state supplies."}]]}]
3e:["$","h3","58",{"className":"mt-8 text-xl font-semibold text-white","children":"What is SGST?"}]
3f:["$","p","59",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"SGST is State Goods and Services Tax. It is generally charged with CGST when supplier location and place of supply are in the same state."}]]}]
40:["$","h3","60",{"className":"mt-8 text-xl font-semibold text-white","children":"What is IGST?"}]
41:["$","p","61",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"IGST is Integrated Goods and Services Tax. It is generally charged for inter-state supplies where supplier location and place of supply are in different states."}]]}]
42:["$","h3","62",{"className":"mt-8 text-xl font-semibold text-white","children":"When should I use CGST and SGST?"}]
43:["$","p","63",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Use CGST and SGST when the transaction is intra-state. For example, a Maharashtra seller billing a Maharashtra buyer may use CGST plus SGST."}]]}]
44:["$","h3","64",{"className":"mt-8 text-xl font-semibold text-white","children":"When should I use IGST?"}]
45:["$","p","65",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Use IGST when the transaction is inter-state. For example, a Delhi seller billing a Karnataka buyer may use IGST."}]]}]
46:["$","h3","66",{"className":"mt-8 text-xl font-semibold text-white","children":"Is 18% GST split as 9% CGST and 9% SGST?"}]
47:["$","p","67",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"For intra-state supplies, 18% GST is commonly split as 9% CGST and 9% SGST."}]]}]
48:["$","h3","68",{"className":"mt-8 text-xl font-semibold text-white","children":"Can CGST, SGST and IGST all be charged together?"}]
49:["$","p","69",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"For a single taxable supply, invoices generally show either CGST plus SGST or IGST, not all three together."}]]}]
