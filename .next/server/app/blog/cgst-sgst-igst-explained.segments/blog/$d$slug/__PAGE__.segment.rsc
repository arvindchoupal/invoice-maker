2:Td4d,[{"@context":"https://schema.org","@type":"BlogPosting","headline":"CGST, SGST and IGST Explained for Small Businesses in India","description":"Understand CGST, SGST and IGST with simple examples, GST invoice format tips, place of supply rules, FAQs and GST calculator links.","datePublished":"2026-05-18","dateModified":"2026-06-09","author":{"@type":"Organization","name":"InvoiceWala Team"},"publisher":{"@type":"Organization","name":"InvoiceWala","url":"https://invoicewala.shop"},"mainEntityOfPage":"https://invoicewala.shop/blog/cgst-sgst-igst-explained"},{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://invoicewala.shop"},{"@type":"ListItem","position":2,"name":"Blog","item":"https://invoicewala.shop/blog"},{"@type":"ListItem","position":3,"name":"CGST, SGST and IGST Explained for Small Businesses in India","item":"https://invoicewala.shop/blog/cgst-sgst-igst-explained"}]},{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What is CGST?","acceptedAnswer":{"@type":"Answer","text":"CGST means Central Goods and Services Tax. It is generally charged with SGST for intra-state supplies where supplier location and place of supply are in the same state."}},{"@type":"Question","name":"What is SGST?","acceptedAnswer":{"@type":"Answer","text":"SGST means State Goods and Services Tax. It is generally charged with CGST for intra-state supplies within a state."}},{"@type":"Question","name":"What is IGST?","acceptedAnswer":{"@type":"Answer","text":"IGST means Integrated Goods and Services Tax. It is generally charged for inter-state supplies where supplier location and place of supply are in different states."}},{"@type":"Question","name":"When should I use CGST and SGST?","acceptedAnswer":{"@type":"Answer","text":"Use CGST and SGST when the transaction is intra-state, meaning the supplier location and place of supply are in the same state."}},{"@type":"Question","name":"When should I use IGST?","acceptedAnswer":{"@type":"Answer","text":"Use IGST when the transaction is inter-state, meaning the supplier location and place of supply are in different states."}},{"@type":"Question","name":"Can CGST, SGST and IGST appear together on the same invoice line?","acceptedAnswer":{"@type":"Answer","text":"For a single taxable supply, the invoice line usually uses either CGST plus SGST or IGST, not all three together."}},{"@type":"Question","name":"How is GST split at 18%?","acceptedAnswer":{"@type":"Answer","text":"For intra-state supply, 18% GST is commonly split as 9% CGST and 9% SGST. For inter-state supply, it is shown as 18% IGST."}},{"@type":"Question","name":"What is place of supply?","acceptedAnswer":{"@type":"Answer","text":"Place of supply is the location used under GST rules to decide whether a transaction is intra-state or inter-state."}},{"@type":"Question","name":"Do freelancers need to understand CGST SGST IGST?","acceptedAnswer":{"@type":"Answer","text":"Yes. GST registered freelancers should understand whether to charge CGST plus SGST or IGST based on supplier location and place of supply."}},{"@type":"Question","name":"Can InvoiceWala calculate CGST SGST and IGST?","acceptedAnswer":{"@type":"Answer","text":"InvoiceWala's GST calculator helps calculate CGST plus SGST or IGST split before creating GST-ready invoices."}}]}]0:{"rsc":["$","$1","c",{"children":[["$","main",null,{"className":"min-h-screen bg-slate-950 text-white","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],"$L3","$L4"]}],["$L5"],"$L6"]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"ZkwzQXTyaT043PsV9iUMg"}
