27:["$","p","35",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"A GST registered freelance designer in Delhi bills a Delhi client ₹25,000 plus 18% GST. This is generally intra-state, so the invoice may show CGST ₹2,250 and SGST ₹2,250."}]]}]
