d:["$","h2","11",{"className":"mt-10 text-2xl font-semibold text-white","children":"How Does an Invoice Generator Work?"}]
e:["$","h3","12",{"className":"mt-8 text-xl font-semibold text-white","children":"1. Enter business details"}]
f:["$","p","13",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Start by adding your business name, address, email, phone number, GSTIN if applicable and logo if you want branded invoices. These details tell the customer who issued the invoice."}]]}]
10:["$","h3","14",{"className":"mt-8 text-xl font-semibold text-white","children":"2. Add customer information"}]
11:["$","p","15",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Add customer name, billing address, email and GSTIN for B2B GST invoices. Accurate customer details help the buyer process payment and keep records."}]]}]
12:["$","h3","16",{"className":"mt-8 text-xl font-semibold text-white","children":"3. Add products or services"}]
13:["$","p","17",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Add each product or service as a line item. Include description, quantity, rate and any discount. For service businesses, write clear descriptions such as Website Design, Monthly SEO Retainer or Site Repair Work."}]]}]
14:["$","h3","18",{"className":"mt-8 text-xl font-semibold text-white","children":"4. Apply taxes and discounts"}]
15:["$","p","19",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"If tax applies, add the tax rate. For GST invoices in India, this may include GST rate and tax split such as CGST, SGST or IGST. Discounts should be shown clearly so the final amount is easy to verify."}]]}]
16:["$","h3","20",{"className":"mt-8 text-xl font-semibold text-white","children":"5. Generate invoice preview"}]
17:["$","p","21",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Before sending, preview the invoice. This helps catch missing details, wrong totals, unclear payment terms or spelling mistakes."}]]}]
18:["$","h3","22",{"className":"mt-8 text-xl font-semibold text-white","children":"6. Download PDF invoice"}]
19:["$","p","23",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"A PDF invoice keeps the format stable when shared on email, WhatsApp or client portals. PDF is usually better than sending editable files."}]]}]
