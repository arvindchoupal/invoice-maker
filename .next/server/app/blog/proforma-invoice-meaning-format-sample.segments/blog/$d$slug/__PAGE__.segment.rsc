c:["$","p","9",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"A proforma invoice is a document that shows the expected details of a sale before the sale is finalized. It may include the buyer name, seller name, product or service list, quantities, rate, tax estimate, total amount, payment method, delivery terms and validity."}]]}]
d:["$","p","10",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"The word “proforma” means “as a matter of form”. In business, this means the document gives a formal preview of a transaction. It helps both sides agree on pricing and terms before the final invoice is issued."}]]}]
e:["$","p","11",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"For example, a manufacturer may send a proforma invoice to a retailer before producing a custom order. A freelancer may send one before starting a project that requires 50% advance payment. An exporter may send one before goods are shipped so the buyer can arrange import approvals."}]]}]
f:["$","h2","12",{"className":"mt-10 text-2xl font-semibold text-white","children":"When Should You Use a Proforma Invoice?"}]
