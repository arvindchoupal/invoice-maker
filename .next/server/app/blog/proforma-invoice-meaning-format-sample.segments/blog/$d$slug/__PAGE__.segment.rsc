2:Te7e,[{"@context":"https://schema.org","@type":"BlogPosting","headline":"What Is a Proforma Invoice? Meaning, Format & Sample","description":"Learn proforma invoice meaning, format, sample, examples, PDF use cases, GST notes and how it differs from invoices and quotations.","datePublished":"2026-05-26","dateModified":"2026-06-15","author":{"@type":"Organization","name":"InvoiceWala Team"},"publisher":{"@type":"Organization","name":"InvoiceWala","url":"https://invoicewala.shop"},"mainEntityOfPage":"https://invoicewala.shop/blog/proforma-invoice-meaning-format-sample"},{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://invoicewala.shop"},{"@type":"ListItem","position":2,"name":"Blog","item":"https://invoicewala.shop/blog"},{"@type":"ListItem","position":3,"name":"What Is a Proforma Invoice? Meaning, Format & Sample","item":"https://invoicewala.shop/blog/proforma-invoice-meaning-format-sample"}]},{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What is a proforma invoice?","acceptedAnswer":{"@type":"Answer","text":"A proforma invoice is a preliminary invoice shared before the final sale. It shows expected items, prices, taxes and terms so the buyer can approve the transaction."}},{"@type":"Question","name":"Is a proforma invoice legally valid?","acceptedAnswer":{"@type":"Answer","text":"A proforma invoice is usually not treated as the final tax invoice or payment document. It is mainly used for confirmation, budgeting, customs or internal approval."}},{"@type":"Question","name":"Can I request payment using a proforma invoice?","acceptedAnswer":{"@type":"Answer","text":"You can request advance confirmation or advance payment terms, but the final taxable sale should be documented with the correct invoice or tax invoice as applicable."}},{"@type":"Question","name":"What is the difference between proforma invoice and invoice?","acceptedAnswer":{"@type":"Answer","text":"A proforma invoice is issued before the final sale. A normal invoice is issued when payment is due or the sale is completed."}},{"@type":"Question","name":"What is the difference between proforma invoice and quotation?","acceptedAnswer":{"@type":"Answer","text":"A quotation is a price offer. A proforma invoice is closer to a draft invoice and often includes invoice-like details for approval, export or advance payment."}},{"@type":"Question","name":"Do proforma invoices need GST?","acceptedAnswer":{"@type":"Answer","text":"A proforma invoice can show expected GST, but GST treatment depends on the final supply and tax invoice. Confirm with your CA for compliance."}},{"@type":"Question","name":"Can freelancers use a proforma invoice?","acceptedAnswer":{"@type":"Answer","text":"Yes. Freelancers can use proforma invoices for advance approval, milestone confirmation or client purchase processing before issuing the final invoice."}},{"@type":"Question","name":"Can I download a proforma invoice PDF?","acceptedAnswer":{"@type":"Answer","text":"Yes. You can create a professional invoice-style document and download it as a PDF for sharing with customers or suppliers."}},{"@type":"Question","name":"Does a proforma invoice need an invoice number?","acceptedAnswer":{"@type":"Answer","text":"It should have a unique proforma reference number, but avoid confusing it with the final tax invoice number unless your accounting process handles that clearly."}},{"@type":"Question","name":"Can a proforma invoice be converted to an invoice?","acceptedAnswer":{"@type":"Answer","text":"Yes. After buyer approval, the details can be used to create a final invoice or GST tax invoice."}}]}]0:{"rsc":["$","$1","c",{"children":[["$","main",null,{"className":"min-h-screen bg-slate-950 text-white","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],"$L3","$L4","$L5"]}],["$L6"],"$L7"]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"spUI00rMsMdPCllRH2xzf"}
