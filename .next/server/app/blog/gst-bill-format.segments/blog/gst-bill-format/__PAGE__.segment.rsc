29:["$","div","Can contractors use GST invoice format?",{"className":"rounded-2xl border border-white/10 bg-slate-950/70 p-5","children":[["$","h3",null,{"className":"font-semibold text-white","children":"Can contractors use GST invoice format?"}],["$","p",null,{"className":"mt-3 text-sm leading-6 text-slate-400","children":"Yes. Contractors can use GST invoice format for labor, materials, milestones and service billing when GST applies."}]]}]
