27:["$","div","What is the difference between bill of supply and tax invoice?",{"className":"rounded-2xl border border-white/10 bg-slate-950/70 p-5","children":[["$","h3",null,{"className":"font-semibold text-white","children":"What is the difference between bill of supply and tax invoice?"}],["$","p",null,{"className":"mt-3 text-sm leading-6 text-slate-400","children":"A tax invoice is used for taxable supplies. A bill of supply is used in cases such as exempt supplies or composition schemes, depending on GST rules."}]]}]
