d:["$","section",null,{"className":"rounded-[2rem] border border-white/10 bg-white/[0.04] p-6 sm:p-8","children":[["$","h2",null,{"className":"text-2xl font-semibold tracking-tight text-white sm:text-3xl","children":"GST Bill Format Example"}],["$","div",null,{"className":"mt-5 space-y-4 text-sm leading-7 text-slate-300 sm:text-base","children":[["$","p",null,{"children":"A simple GST bill format example starts with your business identity at the top: legal business name, address, GSTIN, phone, email and logo. On the right side, show the document title such as Tax Invoice, invoice number, invoice date and due date. Below that, show customer details including customer name, address, GSTIN if available and place of supply."}],["$","p",null,{"children":"The item table should include serial number, item or service description, HSN/SAC, quantity, rate, discount, taxable value, GST rate, tax amount and line total. At the bottom, show subtotal, taxable value, CGST, SGST or IGST, round off if any and grand total. Add payment terms, bank details, notes and authorized signatory."}],["$","div",null,{"className":"mt-5 rounded-2xl border border-white/10 bg-slate-950/80 p-5","children":[["$","p",null,{"className":"font-semibold text-white","children":"Example summary"}],["$","div",null,{"className":"mt-4 grid gap-3 text-sm text-slate-300 sm:grid-cols-2","children":[["$","p",null,{"children":"Supplier: ABC Services Pvt Ltd"}],["$","p",null,{"children":"GSTIN: 29ABCDE1234F1Z5"}],["$","p",null,{"children":"Invoice No: INV-2026-001"}],["$","p",null,{"children":"Invoice Date: 29 May 2026"}],["$","p",null,{"children":"Customer: XYZ Traders"}],["$","p",null,{"children":"Place of Supply: Karnataka"}],["$","p",null,{"children":"Taxable Value: Rs. 39,500"}],["$","p",null,{"children":"Total GST: Rs. 7,110"}]]}]]}]]}]]}]
