27:["$","p","22",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Add client name, company name, email, billing address and GSTIN if available. Client details are especially important when billing agencies, startups or GST registered companies."}]]}]
