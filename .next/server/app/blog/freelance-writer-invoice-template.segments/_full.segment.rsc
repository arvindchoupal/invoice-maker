1e:["$","p","13",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"A clear invoice also protects scope. If you wrote 10 SEO blog articles, mention that. If you wrote landing page copy, product descriptions or social media captions, show those deliverables in the invoice."}]]}]
