ls | Work completed |",{"className":"border-b border-white/10 last:border-0","children":[["$","td","0",{"className":"px-4 py-3 text-slate-300","children":[["$","span","0",{"children":"Article/Project Details"}]]}],["$","td","1",{"className":"px-4 py-3 text-slate-300","children":[["$","span","0",{"children":"Work completed"}]]}]]}],["$","tr","| Rate | Per word, per article or project |",{"className":"border-b border-white/10 last:border-0","children":[["$","td","0",{"className":"px-4 py-3 text-slate-300","children":[["$","span","0",{"children":"Rate"}]]}],["$","td","1",{"className":"px-4 py-3 text-slate-300","children":[["$","span","0",{"children":"Per word, per article or project"}]]}]]}],["$","tr","| Tax | GST if applicable |",{"className":"border-b border-white/10 last:border-0","children":[["$","td","0",{"className":"px-4 py-3 text-slate-300","children":[["$","span","0",{"children":"Tax"}]]}],["$","td","1",{"className":"px-4 py-3 text-slate-300","children":[["$","span","0",{"children":"GST if applicable"}]]}]]}],["$","tr","| Total Amount | Final payable amount |",{"className":"border-b border-white/10 last:border-0","children":[["$","td","0",{"className":"px-4 py-3 text-slate-300","children":[["$","span","0",{"children":"Total Amount"}]]}],["$","td","1",{"className":"px-4 py-3 text-slate-300","children":[["$","span","0",{"children":"Final payable amount"}]]}]]}],["$","tr","| Payment Terms | Due date |",{"className":"border-b border-white/10 last:border-0","children":[["$","td","0",{"className":"px-4 py-3 text-slate-300","children":[["$","span","0",{"children":"Payment Terms"}]]}],["$","td","1",{"className":"px-4 py-3 text-slate-300","children":[["$","span","0",{"children":"Due date"}]]}]]}]]}]}]}]
21:["$","p","16",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"You can also include PAN, GSTIN, SAC code, bank account, UPI ID, purchase order number, project period and notes."}]]}]
