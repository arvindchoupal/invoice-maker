97:["$","p","146",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"SAC code classifies services under GST."}]]}]
98:["$","h3","147",{"className":"mt-8 text-xl font-semibold text-white","children":"What is place of supply?"}]
99:["$","p","148",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Place of supply helps decide whether CGST/SGST or IGST applies."}]]}]
9a:["$","h3","149",{"className":"mt-8 text-xl font-semibold text-white","children":"What is taxable value?"}]
9b:["$","p","150",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Taxable value is the amount on which tax is calculated before GST is added."}]]}]
9c:["$","h3","151",{"className":"mt-8 text-xl font-semibold text-white","children":"How do I calculate tax amount?"}]
9d:["$","p","152",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Tax Amount = Taxable Value x GST Rate / 100."}]]}]
