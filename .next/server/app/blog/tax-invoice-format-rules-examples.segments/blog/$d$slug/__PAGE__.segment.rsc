7a:["$","h3","117",{"className":"mt-8 text-xl font-semibold text-white","children":"What is a tax invoice?"}]
7b:["$","p","118",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"A tax invoice is an invoice issued for taxable goods or services. It shows supplier details, buyer details, invoice number, taxable value, tax rate, tax amount and total payable amount."}]]}]
7c:["$","h3","119",{"className":"mt-8 text-xl font-semibold text-white","children":"What is tax invoice format?"}]
7d:["$","p","120",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Tax invoice format is the structure used to prepare a tax invoice with supplier details, customer details, GSTIN, item rows, taxable value, GST rate, tax amount and final total."}]]}]
7e:["$","h3","121",{"className":"mt-8 text-xl font-semibold text-white","children":"What is the format of tax invoice in India?"}]
7f:["$","p","122",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"A practical tax invoice format in India includes supplier name, address, GSTIN, invoice number, invoice date, buyer details, place of supply, HSN/SAC, taxable value, GST rate, tax amount and total amount."}]]}]
80:["$","h3","123",{"className":"mt-8 text-xl font-semibold text-white","children":"What is a tax invoice sample?"}]
81:["$","p","124",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"A tax invoice sample is an example invoice layout with realistic fields and calculations."}]]}]
82:["$","h3","125",{"className":"mt-8 text-xl font-semibold text-white","children":"What is a tax invoice example?"}]
83:["$","p","126",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"A tax invoice example shows actual numbers, such as Rs. 10,000 taxable value at 18% GST, Rs. 1,800 tax and Rs. 11,800 final invoice total."}]]}]
84:["$","h3","127",{"className":"mt-8 text-xl font-semibold text-white","children":"Is tax invoice required under GST?"}]
85:["$","p","128",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"For taxable supplies by GST registered businesses, a tax invoice is generally required."}]]}]
86:["$","h3","129",{"className":"mt-8 text-xl font-semibold text-white","children":"Who needs a tax invoice?"}]
87:["$","p","130",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Freelancers, consultants, contractors, agencies, retail stores, ecommerce sellers, service businesses and small businesses may need tax invoices."}]]}]
88:["$","h3","131",{"className":"mt-8 text-xl font-semibold text-white","children":"Can freelancers issue tax invoices?"}]
89:["$","p","132",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Yes. GST registered freelancers can issue tax invoices for taxable services when GST applies."}]]}]
8a:["$","h3","133",{"className":"mt-8 text-xl font-semibold text-white","children":"Can consultants issue tax invoices?"}]
8b:["$","p","134",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Yes. Consultants can issue tax invoices for advisory services, retainers and professional services."}]]}]
8c:["$","h3","135",{"className":"mt-8 text-xl font-semibold text-white","children":"Can contractors issue tax invoices?"}]
8d:["$","p","136",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Yes. Contractors can create tax invoices for labor, material, repair jobs and service work."}]]}]
