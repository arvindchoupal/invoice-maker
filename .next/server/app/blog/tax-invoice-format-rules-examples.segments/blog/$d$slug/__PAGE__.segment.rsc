93:["$","p","142",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Important fields include supplier details, buyer details, GSTIN, invoice number, date, place of supply, HSN/SAC, taxable value, GST rate, tax amount and total."}]]}]
