a:["$","span","0",{"children":"The legal importance of a tax invoice depends on the transaction and applicable GST rules. This guide gives a practical overview for Indian businesses, but it is not legal or tax advice. For exact compliance, GST rates, HSN/SAC classification and filing requirements, check with your accountant or tax advisor."}]
b:["$","h2","6",{"className":"mt-10 text-2xl font-semibold text-white","children":"Who Needs a Tax Invoice?"}]
c:["$","p","7",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Tax invoices are needed by businesses and professionals that sell taxable goods or services, especially when they are GST registered. The format may be simple or detailed, but the invoice should clearly show the transaction and tax details."}]]}]
d:["$","p","8",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Common users include:"}]]}]
e:["$","ul","9",{"className":"mt-4 list-disc space-y-2 pl-6 text-slate-300","children":[["$","li","Freelancers billing design, writing, software, marketing or consulting work",{"children":[["$","span","0",{"children":"Freelancers billing design, writing, software, marketing or consulting work"}]]}],["$","li","Consultants billing retainers, advisory work or implementation projects",{"children":[["$","span","0",{"children":"Consultants billing retainers, advisory work or implementation projects"}]]}],["$","li","Contractors billing labor, material, repairs, site visits or milestones",{"children":[["$","span","0",{"children":"Contractors billing labor, material, repairs, site visits or milestones"}]]}],["$","li","Agencies billing SEO, ads, creative work, development and monthly retainers",{"children":[["$","span","0",{"children":"Agencies billing SEO, ads, creative work, development and monthly retainers"}]]}],["$","li","Retail stores selling taxable products to customers or businesses",{"children":[["$","span","0",{"children":"Retail stores selling taxable products to customers or businesses"}]]}],["$","li","Ecommerce sellers creating invoices for online orders",{"children":[["$","span","0",{"children":"Ecommerce sellers creating invoices for online orders"}]]}],["$","li","Service businesses such as repair teams, technicians, trainers, accountants or local service providers",{"children":[["$","span","0",{"children":"Service businesses such as repair teams, technicians, trainers, accountants or local service providers"}]]}],["$","li","Small businesses and Indian startups billing customers professionally",{"children":[["$","span","0",{"children":"Small businesses and Indian startups billing customers professionally"}]]}]]}]
f:["$","p","10",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"If your customer is a GST registered business, they may ask for a proper gst tax invoice with GSTIN and tax breakup. Even if the customer is not GST registered, a clean tax invoice helps you keep organized records and follow up on payment."}]]}]
10:["$","h2","11",{"className":"mt-10 text-2xl font-semibold text-white","children":"Tax Invoice Format"}]
11:["$","p","12",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"A good tax invoice format is clear, consistent and easy to read. It should not force the customer to guess what was sold, what tax was charged or how the final total was calculated."}]]}]
12:["$","h3","13",{"className":"mt-8 text-xl font-semibold text-white","children":"Supplier Name"}]
13:["$","p","14",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Supplier name is the legal or trade name of the business issuing the tax invoice. It should match your business records and GST registration where applicable."}]]}]
14:["$","h3","15",{"className":"mt-8 text-xl font-semibold text-white","children":"Supplier Address"}]
15:["$","p","16",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Supplier address identifies the seller or service provider location. It is useful for records, GST details and customer communication."}]]}]
16:["$","h3","17",{"className":"mt-8 text-xl font-semibold text-white","children":"GSTIN"}]
17:["$","p","18",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"GSTIN is the Goods and Services Tax Identification Number. A GST registered supplier should show GSTIN on the invoice. For B2B invoices, buyer GSTIN should also be added when available."}]]}]
18:["$","h3","19",{"className":"mt-8 text-xl font-semibold text-white","children":"Invoice Number"}]
19:["$","p","20",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Invoice number is a unique identifier for the invoice. Use a clean series such as INV-2026-001, FY26-001 or CLIENT-001. Avoid repeating invoice numbers. You can use the "}],["$","$L8","1",{"className":"font-semibold text-cyan-300 underline-offset-2 hover:underline","href":"/tools/invoice-number-generator","children":"Invoice Number Generator"}],["$","span","2",{"children":" to plan a simple numbering format."}]]}]
1a:["$","h3","21",{"className":"mt-8 text-xl font-semibold text-white","children":"Invoice Date"}]
1b:["$","p","22",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Invoice date shows when the invoice was issued. It is important for payment due dates, accounting records and GST reporting."}]]}]
1c:["$","h3","23",{"className":"mt-8 text-xl font-semibold text-white","children":"Buyer Details"}]
1d:["$","p","24",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Buyer details include customer name, billing address, email, phone and GSTIN for registered B2B customers. Missing buyer details can create confusion later."}]]}]
1e:["$","h3","25",{"className":"mt-8 text-xl font-semibold text-white","children":"Place of Supply"}]
1f:["$","p","26",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Place of supply helps decide whether CGST/SGST or IGST applies. This is especially important when the seller and buyer are in different states."}]]}]
20:["$","h3","27",{"className":"mt-8 text-xl font-semibold text-white","children":"HSN Code"}]
21:["$","p","28",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"HSN code is used for goods. Retailers, product sellers, distributors and manufacturers commonly use HSN codes in tax invoices."}]]}]
22:["$","h3","29",{"className":"mt-8 text-xl font-semibold text-white","children":"SAC Code"}]
23:["$","p","30",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"SAC code is used for services. Freelancers, consultants, agencies and service businesses may need SAC codes on tax invoices."}]]}]
24:["$","h3","31",{"className":"mt-8 text-xl font-semibold text-white","children":"Taxable Value"}]
25:["$","p","32",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Taxable value is the amount on which tax is calculated. It is usually the item value after eligible discount and before GST is added."}]]}]
26:["$","h3","33",{"className":"mt-8 text-xl font-semibold text-white","children":"GST Rate"}]
27:["$","p","34",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"GST rate is the tax percentage applied to the taxable value. Common GST rates include 0%, 5%, 12%, 18% and 28%. The correct rate depends on the product or service."}]]}]
28:["$","h3","35",{"className":"mt-8 text-xl font-semibold text-white","children":"Tax Amount"}]
29:["$","p","36",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Tax amount is calculated from taxable value and GST rate. For example, Rs. 10,000 at 18% GST gives Rs. 1,800 tax."}]]}]
2a:["$","h3","37",{"className":"mt-8 text-xl font-semibold text-white","children":"Total Amount"}]
2b:["$","p","38",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Total amount is the final amount payable by the customer after adding tax and other applicable charges."}]]}]
2c:["$","h3","39",{"className":"mt-8 text-xl font-semibold text-white","children":"Payment Terms"}]
2d:["$","p","40",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Payment terms explain when and how the customer should pay. Examples include due on receipt, due within 7 days, bank transfer details or UPI details."}]]}]
2e:["$","h2","41",{"className":"mt-10 text-2xl font-semibold text-white","children":"Tax Invoice Sample"}]
