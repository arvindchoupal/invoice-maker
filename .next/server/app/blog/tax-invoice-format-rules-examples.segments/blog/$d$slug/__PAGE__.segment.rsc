8f:["$","p","138",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"A GST tax invoice is a tax invoice that includes GST details such as GSTIN, HSN/SAC, taxable value, GST rate and tax amount."}]]}]
90:["$","h3","139",{"className":"mt-8 text-xl font-semibold text-white","children":"Is tax invoice and GST invoice the same?"}]
91:["$","p","140",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"In common usage, people often use both terms similarly. Tax invoice is the formal document for taxable supplies."}]]}]
