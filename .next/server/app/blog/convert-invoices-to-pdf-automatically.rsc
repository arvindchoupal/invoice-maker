4c:["$","p","56",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"The designer enters these details in an invoice generator, selects a modern template, checks the PDF preview and downloads the invoice PDF. The PDF can then be emailed to the client or shared on WhatsApp. The designer does not need to adjust rows, resize columns or export from Excel manually."}]]}]
4d:["$","h2","57",{"className":"mt-10 text-2xl font-semibold text-white","children":"Common Invoice PDF Mistakes"}]
4e:["$","p","58",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Even when the PDF looks clean, small mistakes can delay payments. Check these before sending:"}]]}]
