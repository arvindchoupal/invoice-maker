3c:["$","p","40",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"A clean invoice PDF format should be readable first and decorative second. Beautiful templates are useful, but the customer must be able to quickly find the amount due, payment deadline and invoice reference."}]]}]
3d:["$","h2","41",{"className":"mt-10 text-2xl font-semibold text-white","children":"GST Invoice PDF in India"}]
3e:["$","p","42",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"If GST applies to your business, your invoice PDF needs more structure than a simple payment request. A GST invoice PDF may include supplier GSTIN, customer GSTIN, place of supply, HSN or SAC code, taxable value, GST rate, CGST, SGST, IGST and total invoice value."}]]}]
3f:["$","p","43",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"For example, if an Indian freelancer bills a client in the same state for services worth ₹10,000 at 18% GST, the GST may be split as:"}]]}]
