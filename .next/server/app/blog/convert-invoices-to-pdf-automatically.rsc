29:["$","p","21",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Manual templates are fine for one or two invoices, but they become frustrating when you invoice often. Automatic PDF generation is better when you want repeatable billing, cleaner formatting and fewer calculation mistakes."}]]}]
2a:["$","h2","22",{"className":"mt-10 text-2xl font-semibold text-white","children":"How Automatic Invoice PDF Generation Works"}]
2b:["$","p","23",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Automatic invoice PDF generation usually follows a simple workflow."}]]}]
2c:["$","h3","24",{"className":"mt-8 text-xl font-semibold text-white","children":"1. Enter Business Details"}]
2d:["$","p","25",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Add your business name, email, address, phone number and GSTIN if applicable. If your invoice tool saves your profile, these details can be reused for future invoices."}]]}]
2e:["$","h3","26",{"className":"mt-8 text-xl font-semibold text-white","children":"2. Add Customer Information"}]
2f:["$","p","27",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Enter the customer name, email, address and GSTIN where needed. For B2B GST invoices, customer GSTIN and place of supply may be important."}]]}]
30:["$","h3","28",{"className":"mt-8 text-xl font-semibold text-white","children":"3. Add Products or Services"}]
31:["$","p","29",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Add invoice line items such as website design, repair service, consultation, material supply, installation, monthly retainer or product sale. Each line usually includes item name, description, quantity, rate, tax and discount."}]]}]
32:["$","h3","30",{"className":"mt-8 text-xl font-semibold text-white","children":"4. Calculate Subtotal, Tax and Total"}]
33:["$","p","31",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"The invoice tool calculates subtotal, discount, GST or tax amount and grand total. This reduces mistakes compared with manually editing formulas in Excel."}]]}]
34:["$","h3","32",{"className":"mt-8 text-xl font-semibold text-white","children":"5. Choose PDF Template"}]
35:["$","p","33",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Pick an invoice template that matches your business type. A freelancer may prefer a minimal template. A GST business may need a tax-focused layout. A contractor may want material and labor details."}]]}]
36:["$","h3","34",{"className":"mt-8 text-xl font-semibold text-white","children":"6. Preview the Invoice"}]
37:["$","p","35",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Check the invoice PDF preview before downloading. Make sure customer details, totals, date, invoice number and payment terms are correct."}]]}]
38:["$","h3","36",{"className":"mt-8 text-xl font-semibold text-white","children":"7. Download or Share PDF"}]
39:["$","p","37",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Download the PDF invoice and send it to the customer through email, WhatsApp or your normal payment follow-up workflow."}]]}]
