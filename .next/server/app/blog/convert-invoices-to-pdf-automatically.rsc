44:["$","h2","48",{"className":"mt-10 text-2xl font-semibold text-white","children":"PDF Invoice Templates"}]
45:["$","p","49",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"An invoice PDF template controls the look and structure of the final invoice. It decides where the logo appears, how the item table is designed, how totals are displayed and whether the invoice feels minimal, corporate, creative or GST-focused."}]]}]
46:["$","p","50",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Common PDF invoice template types include:"}]]}]
47:["$","ul","51",{"className":"mt-4 list-disc space-y-2 pl-6 text-slate-300","children":[["$","li","Minimal invoice PDF for freelancers and consultants",{"children":[["$","span","0",{"children":"Minimal invoice PDF for freelancers and consultants"}]]}],["$","li","GST invoice PDF for Indian tax invoices",{"children":[["$","span","0",{"children":"GST invoice PDF for Indian tax invoices"}]]}],["$","li","Corporate invoice PDF for agencies and B2B service providers",{"children":[["$","span","0",{"children":"Corporate invoice PDF for agencies and B2B service providers"}]]}],["$","li","Contractor invoice PDF with labor and material rows",{"children":[["$","span","0",{"children":"Contractor invoice PDF with labor and material rows"}]]}],["$","li","Retail invoice PDF with product quantity and tax details",{"children":[["$","span","0",{"children":"Retail invoice PDF with product quantity and tax details"}]]}],["$","li","Quotation or estimate PDF for pre-sale pricing documents",{"children":[["$","span","0",{"children":"Quotation or estimate PDF for pre-sale pricing documents"}]]}]]}]
48:["$","p","52",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Template choice matters because different businesses need different information. A contractor may want separate material and labor breakdowns. An agency may want project summary and milestone details. A GST business may want tax breakup to stand out clearly."}]]}]
