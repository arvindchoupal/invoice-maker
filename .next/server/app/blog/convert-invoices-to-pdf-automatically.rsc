50:["$","p","60",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"A good invoice PDF should make the payment decision easy for the customer. They should not need to ask what the invoice is for, when it is due or how to pay."}]]}]
