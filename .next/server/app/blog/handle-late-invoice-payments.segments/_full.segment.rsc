18:["$","p","8",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"For large companies, one unpaid invoice may be a reporting issue. For a freelancer or small business, it can affect rent, salaries, vendor payments, subscriptions and personal cash flow. Late payments also waste time because you keep checking bank accounts, sending messages and re-explaining the same invoice."}]]}]
19:["$","p","9",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Late payment problems usually happen because of one or more of these reasons:"}]]}]
