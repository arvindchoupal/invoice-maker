s"}]]}]]}],["$","tr","| Firm reminder | 7 days overdue | Direct | Request payment date |",{"className":"border-b border-white/10 last:border-0","children":[["$","td","0",{"className":"px-4 py-3 text-slate-300","children":[["$","span","0",{"children":"Firm reminder"}]]}],["$","td","1",{"className":"px-4 py-3 text-slate-300","children":[["$","span","0",{"children":"7 days overdue"}]]}],["$","td","2",{"className":"px-4 py-3 text-slate-300","children":[["$","span","0",{"children":"Direct"}]]}],["$","td","3",{"className":"px-4 py-3 text-slate-300","children":[["$","span","0",{"children":"Request payment date"}]]}]]}],["$","tr","| Final notice | 14-30 days overdue | Formal | Escalate or pause work |",{"className":"border-b border-white/10 last:border-0","children":[["$","td","0",{"className":"px-4 py-3 text-slate-300","children":[["$","span","0",{"children":"Final notice"}]]}],["$","td","1",{"className":"px-4 py-3 text-slate-300","children":[["$","span","0",{"children":"14-30 days overdue"}]]}],["$","td","2",{"className":"px-4 py-3 text-slate-300","children":[["$","span","0",{"children":"Formal"}]]}],["$","td","3",{"className":"px-4 py-3 text-slate-300","children":[["$","span","0",{"children":"Escalate or pause work"}]]}]]}]]}]}]}]
