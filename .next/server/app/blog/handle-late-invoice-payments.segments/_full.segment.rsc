68:["$","h2","88",{"className":"mt-10 text-2xl font-semibold text-white","children":"Final Takeaway"}]
69:["$","p","89",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Late payments are uncomfortable, but they become easier to manage when your process is clear. Send invoices on time, mention payment terms, make payment easy, track status and follow up with a consistent reminder timeline."}]]}]
6a:["$","p","90",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Start polite. Become clearer if the invoice remains unpaid. Protect your cash flow by pausing future work when needed."}]]}]
6b:["$","p","91",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Use InvoiceWala to create professional invoices, then use the payment reminder generator to follow up without awkwardness."}]]}]
6c:["$","h2","92",{"className":"mt-10 text-2xl font-semibold text-white","children":"Frequently Asked Questions"}]
6d:["$","h3","93",{"className":"mt-8 text-xl font-semibold text-white","children":"What is a late invoice payment?"}]
6e:["$","p","94",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"A late invoice payment is an invoice that remains unpaid after the due date mentioned in the invoice or agreed payment terms."}]]}]
6f:["$","h3","95",{"className":"mt-8 text-xl font-semibold text-white","children":"When should I send the first payment reminder?"}]
70:["$","p","96",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Send the first reminder on the due date or one day after. For important invoices, send a friendly reminder before the due date."}]]}]
71:["$","h3","97",{"className":"mt-8 text-xl font-semibold text-white","children":"How do I politely ask for payment?"}]
72:["$","p","98",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Mention the invoice number, amount, due date and payment method. Keep the message short and respectful."}]]}]
73:["$","h3","99",{"className":"mt-8 text-xl font-semibold text-white","children":"Can I send a payment reminder on WhatsApp?"}]
74:["$","p","100",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Yes. WhatsApp reminders work well when the client already uses WhatsApp for business communication."}]]}]
75:["$","h3","101",{"className":"mt-8 text-xl font-semibold text-white","children":"What should an overdue invoice email include?"}]
76:["$","p","102",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"It should include invoice number, amount due, original due date, payment details and a request for confirmation."}]]}]
77:["$","h3","103",{"className":"mt-8 text-xl font-semibold text-white","children":"How often should I follow up?"}]
78:["$","p","104",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"A practical timeline is due date, 3 days overdue, 7 days overdue and 14 days overdue."}]]}]
79:["$","h3","105",{"className":"mt-8 text-xl font-semibold text-white","children":"Should I stop work if payment is late?"}]
7a:["$","p","106",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"If an invoice remains unpaid and your agreement allows it, pausing new work can protect your cash flow."}]]}]
7b:["$","h3","107",{"className":"mt-8 text-xl font-semibold text-white","children":"Can I charge late payment fees?"}]
7c:["$","p","108",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"You can consider late fees if they were clearly agreed in advance. Confirm legal and tax treatment with an advisor."}]]}]
7d:["$","h3","109",{"className":"mt-8 text-xl font-semibold text-white","children":"How do freelancers avoid late payments?"}]
7e:["$","p","110",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Use advance payment, milestone billing, clear due dates, written scope and professional invoices."}]]}]
7f:["$","h3","111",{"className":"mt-8 text-xl font-semibold text-white","children":"What is the best payment reminder message?"}]
80:["$","p","112",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"The best message is specific, polite and direct. Include invoice number, amount, due date and payment instructions."}]]}]
81:["$","h3","113",{"className":"mt-8 text-xl font-semibold text-white","children":"Can I send reminders before the due date?"}]
82:["$","p","114",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Yes. A friendly reminder before the due date can help clients plan payment."}]]}]
83:["$","h3","115",{"className":"mt-8 text-xl font-semibold text-white","children":"Should I attach the invoice again?"}]
84:["$","p","116",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Yes. Attaching or linking the invoice again makes it easier for the client to pay without searching old emails."}]]}]
85:["$","h3","117",{"className":"mt-8 text-xl font-semibold text-white","children":"What if the client says payment is processed?"}]
86:["$","p","118",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Ask for the transaction reference or expected settlement date so you can update your records."}]]}]
87:["$","h3","119",{"className":"mt-8 text-xl font-semibold text-white","children":"How can InvoiceWala help?"}]
88:["$","p","120",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"InvoiceWala helps create professional invoices, track invoice status and generate reminder messages for overdue payments."}]]}]
89:["$","h3","121",{"className":"mt-8 text-xl font-semibold text-white","children":"Is the payment reminder generator free?"}]
8a:["$","p","122",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Yes. InvoiceWala's payment reminder generator is a free public tool for writing polite reminder messages."}]]}]
