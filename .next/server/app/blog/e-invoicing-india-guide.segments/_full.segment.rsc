3f:["$","p","47",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"An e-invoice can still be shared as a PDF. The difference is that the invoice data has been registered and validated under the e-invoice system."}]]}]
40:["$","h2","48",{"className":"mt-10 text-2xl font-semibold text-white","children":"B2B and B2C E-Invoice Confusion"}]
41:["$","p","49",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Most GST e-invoicing discussion focuses on B2B invoices, exports and specified GST documents for applicable taxpayers. B2C invoices may have separate QR code or compliance rules depending on business type and notification."}]]}]
42:["$","p","50",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Do not assume one rule applies to every invoice. Check the current official guidance for:"}]]}]
43:["$","ul","51",{"className":"mt-4 list-disc space-y-2 pl-6 text-slate-300","children":[["$","li","B2B invoices",{"children":[["$","span","0",{"children":"B2B invoices"}]]}],["$","li","Export invoices",{"children":[["$","span","0",{"children":"Export invoices"}]]}],["$","li","Credit notes",{"children":[["$","span","0",{"children":"Credit notes"}]]}],["$","li","Debit notes",{"children":[["$","span","0",{"children":"Debit notes"}]]}],["$","li","B2C invoice QR requirements",{"children":[["$","span","0",{"children":"B2C invoice QR requirements"}]]}],["$","li","Sector-specific exceptions",{"children":[["$","span","0",{"children":"Sector-specific exceptions"}]]}]]}]
44:["$","h2","52",{"className":"mt-10 text-2xl font-semibold text-white","children":"Common E-Invoice Errors"}]
45:["$","p","53",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Many e-invoice problems are not technical. They are basic invoice data problems."}]]}]
46:["$","h3","54",{"className":"mt-8 text-xl font-semibold text-white","children":"Invalid GSTIN"}]
47:["$","p","55",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"If the buyer GSTIN or supplier GSTIN is wrong, validation can fail. Always copy GSTIN carefully and verify important clients."}]]}]
48:["$","h3","56",{"className":"mt-8 text-xl font-semibold text-white","children":"Duplicate Invoice Number"}]
49:["$","p","57",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Your invoice number should not be reused for the same GSTIN and period where rules prohibit duplication. Avoid random numbering and deleted-invoice reuse."}]]}]
4a:["$","h3","58",{"className":"mt-8 text-xl font-semibold text-white","children":"Wrong HSN or SAC"}]
4b:["$","p","59",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Goods usually use HSN codes, while services use SAC codes. Wrong or missing classification creates compliance risk."}]]}]
4c:["$","h3","60",{"className":"mt-8 text-xl font-semibold text-white","children":"Tax Mismatch"}]
4d:["$","p","61",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"If taxable value, GST rate and tax amount do not mathematically match, the invoice may be rejected or need correction."}]]}]
4e:["$","h3","62",{"className":"mt-8 text-xl font-semibold text-white","children":"Wrong Place of Supply"}]
4f:["$","p","63",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Place of supply affects whether CGST/SGST or IGST applies. This is a common mistake for interstate clients."}]]}]
50:["$","h3","64",{"className":"mt-8 text-xl font-semibold text-white","children":"Missing Buyer Details"}]
51:["$","p","65",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Incomplete customer name, address or GSTIN can cause issues, especially for B2B invoices."}]]}]
52:["$","h3","66",{"className":"mt-8 text-xl font-semibold text-white","children":"Incorrect Document Type"}]
53:["$","p","67",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Invoice, credit note and debit note workflows are not identical. Use the right document type."}]]}]
54:["$","h2","68",{"className":"mt-10 text-2xl font-semibold text-white","children":"How to Prepare Your Business for E-Invoicing"}]
55:["$","p","69",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Even if e-invoicing does not apply to your business today, it is smart to prepare early."}]]}]
