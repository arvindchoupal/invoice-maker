e and address"}]]}],["$","td","1",{"className":"px-4 py-3 text-slate-300","children":[["$","span","0",{"children":"Helps avoid disputes and mismatches"}]]}]]}],["$","tr","| Invoice number | Must be unique and consistent |",{"className":"border-b border-white/10 last:border-0","children":[["$","td","0",{"className":"px-4 py-3 text-slate-300","children":[["$","span","0",{"children":"Invoice number"}]]}],["$","td","1",{"className":"px-4 py-3 text-slate-300","children":[["$","span","0",{"children":"Must be unique and consistent"}]]}]]}],["$","tr","| Invoice date | Needed for tax period and reporting |",{"className":"border-b border-white/10 last:border-0","children":[["$","td","0",{"className":"px-4 py-3 text-slate-300","children":[["$","span","0",{"children":"Invoice date"}]]}],["$","td","1",{"className":"px-4 py-3 text-slate-300","children":[["$","span","0",{"children":"Needed for tax period and reporting"}]]}]]}],["$","tr","| Document type | Invoice, credit note, debit note or other supported document |",{"className":"border-b border-white/10 last:border-0","children":[["$","td","0",{"className":"px-4 py-3 text-slate-300","children":[["$","span","0",{"children":"Document type"}]]}],["$","td","1",{"className":"px-4 py-3 text-slate-300","children":[["$","span","0",{"children":"Invoice, credit note, debit note or other supported document"}]]}]]}],["$","tr","| Place of supply | Decides tax treatment in many cases |",{"className":"border-b border-white/10 last:border-0","children":[["$","td","0",{"className":"px-4 py-3 text-slate-300","children":[["$","span","0",{"children":"Place of supply"}]]}],["$","td","1",{"className":"px-4 py-3 text-slate-300","children":[["$","span","0",{"children":"Decides tax treatment in many cases"}]]}]]}],["$","tr","| HSN or SAC | Classifies goods or services |",{"className":"border-b border-white/10 last:border-0","children":[["$","td","0",{"className":"px-4 py-3 text-slate-300","children":[["$","span","0",{"children":"HSN or SAC"}]]}],["$","