d:["$","p","10",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"For example, a web developer registered under GST may need to create a GST invoice for website development services. A contractor may need to create a GST invoice for labor and material. A marketing agency may need to create a monthly GST tax invoice for campaign management. A shop may need to issue a GST bill for product sales."}]]}]
e:["$","p","11",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Even if your customer does not ask for a detailed format, a proper GST invoice helps your own records. It makes revenue tracking, GST calculation, payment reminders and reports easier."}]]}]
