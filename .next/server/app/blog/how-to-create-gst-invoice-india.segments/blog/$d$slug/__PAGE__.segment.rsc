71:["$","h2","110",{"className":"mt-10 text-2xl font-semibold text-white","children":"Frequently Asked Questions"}]
72:["$","h3","111",{"className":"mt-8 text-xl font-semibold text-white","children":"What is a GST invoice?"}]
73:["$","p","112",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"A GST invoice is a tax invoice issued for taxable goods or services under GST. It shows supplier details, buyer details, GSTIN, invoice number, taxable value, GST rate, tax amount and total invoice value."}]]}]
74:["$","h3","113",{"className":"mt-8 text-xl font-semibold text-white","children":"How to create GST invoice online?"}]
75:["$","p","114",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Use a GST invoice generator, add business and customer details, add items, select GST rate, check totals and download the GST invoice PDF."}]]}]
76:["$","h3","115",{"className":"mt-8 text-xl font-semibold text-white","children":"Who needs a GST invoice?"}]
77:["$","p","116",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"GST registered freelancers, consultants, contractors, agencies, service providers, product sellers and small businesses may need GST invoices."}]]}]
78:["$","h3","117",{"className":"mt-8 text-xl font-semibold text-white","children":"What is GST invoice format?"}]
79:["$","p","118",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"GST invoice format is the structure of the invoice, including supplier details, buyer details, invoice number, GSTIN, HSN/SAC, taxable value, GST breakup and total."}]]}]
7a:["$","h3","119",{"className":"mt-8 text-xl font-semibold text-white","children":"Can freelancers create GST invoices?"}]
7b:["$","p","120",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Yes. GST registered freelancers can create GST invoices for taxable services when GST applies."}]]}]
7c:["$","h3","121",{"className":"mt-8 text-xl font-semibold text-white","children":"Can contractors create GST invoices?"}]
7d:["$","p","122",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Yes. Contractors can create GST invoices for labor, materials, milestones and service work when applicable."}]]}]
7e:["$","h3","123",{"className":"mt-8 text-xl font-semibold text-white","children":"What is GSTIN?"}]
7f:["$","p","124",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"GSTIN is the Goods and Services Tax Identification Number of a registered business."}]]}]
80:["$","h3","125",{"className":"mt-8 text-xl font-semibold text-white","children":"Is customer GSTIN mandatory?"}]
81:["$","p","126",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Customer GSTIN is important for B2B invoices when the buyer is GST registered and wants input tax credit."}]]}]
82:["$","h3","127",{"className":"mt-8 text-xl font-semibold text-white","children":"What is HSN code?"}]
83:["$","p","128",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"HSN code classifies goods under GST."}]]}]
84:["$","h3","129",{"className":"mt-8 text-xl font-semibold text-white","children":"What is SAC code?"}]
85:["$","p","130",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"SAC code classifies services under GST."}]]}]
86:["$","h3","131",{"className":"mt-8 text-xl font-semibold text-white","children":"What is place of supply?"}]
87:["$","p","132",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Place of supply helps decide whether CGST/SGST or IGST applies."}]]}]
88:["$","h3","133",{"className":"mt-8 text-xl font-semibold text-white","children":"What is taxable value?"}]
89:["$","p","134",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Taxable value is the amount on which GST is calculated before adding GST."}]]}]
8a:["$","h3","135",{"className":"mt-8 text-xl font-semibold text-white","children":"What is CGST?"}]
8b:["$","p","136",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"CGST is Central GST, generally used with SGST for intra-state supplies."}]]}]
8c:["$","h3","137",{"className":"mt-8 text-xl font-semibold text-white","children":"What is SGST?"}]
8d:["$","p","138",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"SGST is State GST, generally used with CGST for intra-state supplies."}]]}]
8e:["$","h3","139",{"className":"mt-8 text-xl font-semibold text-white","children":"What is IGST?"}]
8f:["$","p","140",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"IGST is Integrated GST, generally used for inter-state supplies."}]]}]
90:["$","h3","141",{"className":"mt-8 text-xl font-semibold text-white","children":"How do I calculate GST amount?"}]
91:["$","p","142",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"GST Amount = Taxable Value x GST Rate / 100."}]]}]
92:["$","h3","143",{"className":"mt-8 text-xl font-semibold text-white","children":"Can I download GST invoice PDF?"}]
93:["$","p","144",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Yes. InvoiceWala lets you create GST invoices online and download professional PDF invoices after signup or login."}]]}]
94:["$","h3","145",{"className":"mt-8 text-xl font-semibold text-white","children":"Can I use Excel GST invoice templates?"}]
95:["$","p","146",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Yes, but online generators reduce formula and formatting mistakes."}]]}]
96:["$","h3","147",{"className":"mt-8 text-xl font-semibold text-white","children":"What is a GST invoice generator?"}]
97:["$","p","148",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"A GST invoice generator is a tool that creates GST invoices with tax fields, item rows, totals and PDF output."}]]}]
98:["$","h3","149",{"className":"mt-8 text-xl font-semibold text-white","children":"What GST rates are common?"}]
99:["$","p","150",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Common GST rates include 0%, 5%, 12%, 18% and 28%."}]]}]
9a:["$","h3","151",{"className":"mt-8 text-xl font-semibold text-white","children":"Should invoice number be unique?"}]
9b:["$","p","152",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Yes. Invoice numbers should be unique within the invoice series."}]]}]
9c:["$","h3","153",{"className":"mt-8 text-xl font-semibold text-white","children":"Can GST invoice numbers repeat?"}]
9d:["$","p","154",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"No. Repeating invoice numbers can create record and audit confusion."}]]}]
9e:["$","h3","155",{"className":"mt-8 text-xl font-semibold text-white","children":"What is GST bill format?"}]
9f:["$","p","156",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"GST bill format is a common phrase for GST invoice format or GST tax invoice format."}]]}]
