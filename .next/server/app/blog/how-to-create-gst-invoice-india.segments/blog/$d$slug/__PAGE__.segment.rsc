4b:["$","p","72",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Add customer name, billing address, email and GSTIN if the customer is GST registered. For B2B customers, GSTIN accuracy matters."}]]}]
4c:["$","h3","73",{"className":"mt-8 text-xl font-semibold text-white","children":"Step 3: Create a unique invoice number"}]
4d:["$","p","74",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Use a clear invoice number series. Examples include INV-0001, FY26-001 or IW-2026-001. Avoid duplicate invoice numbers. If you need ideas, use the "}],["$","$L7","1",{"className":"font-semibold text-cyan-300 underline-offset-2 hover:underline","href":"/tools/invoice-number-generator","children":"Invoice Number Generator"}],["$","span","2",{"children":"."}]]}]
4e:["$","h3","75",{"className":"mt-8 text-xl font-semibold text-white","children":"Step 4: Add invoice date and due date"}]
4f:["$","p","76",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Invoice date shows when the document is issued. Due date tells the customer when payment is expected. Clear payment terms reduce follow-up confusion."}]]}]
50:["$","h3","77",{"className":"mt-8 text-xl font-semibold text-white","children":"Step 5: Add line items"}]
51:["$","p","78",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Add each product or service with description, HSN/SAC, quantity, rate, discount if any and taxable value. Keep descriptions simple and specific."}]]}]
