42:["$","p","63",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Intra-state supply generally means seller and buyer are in the same state. For example, a Delhi freelancer billing a Delhi client may show CGST and SGST. On Rs. 10,000 at 18%, CGST is Rs. 900 and SGST is Rs. 900."}]]}]
43:["$","h3","64",{"className":"mt-8 text-xl font-semibold text-white","children":"Inter-state supply"}]
