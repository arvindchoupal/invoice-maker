53:["$","p","80",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Add the correct GST rate for each item or service. Common rates include 5%, 12%, 18% and 28%, but the correct rate depends on your product or service category."}]]}]
54:["$","h3","81",{"className":"mt-8 text-xl font-semibold text-white","children":"Step 7: Choose CGST/SGST or IGST"}]
55:["$","p","82",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Use place of supply to decide tax split. Same-state supplies generally use CGST and SGST. Different-state supplies generally use IGST."}]]}]
