67:["$","p","100",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"There are three common ways to use a GST invoice template."}]]}]
68:["$","h3","101",{"className":"mt-8 text-xl font-semibold text-white","children":"Word templates"}]
69:["$","p","102",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Word templates are simple for one-time invoices but require manual editing. Calculations are not automatic unless you manage them separately."}]]}]
