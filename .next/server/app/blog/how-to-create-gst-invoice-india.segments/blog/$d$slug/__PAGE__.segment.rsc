18:["$","p","21",{"className":"mt-4 text-base leading-8 text-slate-300","children":[["$","span","0",{"children":"Every GST invoice should have a unique invoice number. A clean format such as INV-2026-001, FY26-001 or CLIENT-001 helps with tracking. You can use the "}],["$","$L7","1",{"className":"font-semibold text-cyan-300 underline-offset-2 hover:underline","href":"/tools/invoice-number-generator","children":"Invoice Number Generator"}],["$","span","2",{"children":" if you are starting a new series."}]]}]
