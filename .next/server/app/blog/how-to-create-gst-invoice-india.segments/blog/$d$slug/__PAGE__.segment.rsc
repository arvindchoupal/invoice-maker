2:T1ab6,[{"@context":"https://schema.org","@type":"BlogPosting","headline":"How to Create a GST Invoice in India (Step-by-Step Guide)","description":"Learn how to create GST invoice in India with GST invoice format, examples, CGST/SGST/IGST, PDF templates, mistakes and FAQs.","datePublished":"2026-05-20","dateModified":"2026-05-30","author":{"@type":"Organization","name":"InvoiceWala Team"},"publisher":{"@type":"Organization","name":"InvoiceWala","url":"https://invoicewala.shop"},"mainEntityOfPage":"https://invoicewala.shop/blog/how-to-create-gst-invoice-india"},{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://invoicewala.shop"},{"@type":"ListItem","position":2,"name":"Blog","item":"https://invoicewala.shop/blog"},{"@type":"ListItem","position":3,"name":"How to Create a GST Invoice in India (Step-by-Step Guide)","item":"https://invoicewala.shop/blog/how-to-create-gst-invoice-india"}]},{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What is a GST invoice?","acceptedAnswer":{"@type":"Answer","text":"A GST invoice is a tax invoice issued for taxable goods or services under GST. It shows supplier details, buyer details, GSTIN, invoice number, taxable value, GST rate, tax amount and total invoice value."}},{"@type":"Question","name":"How to create GST invoice online?","acceptedAnswer":{"@type":"Answer","text":"Add your business details, customer details, GSTIN, invoice number, line items, HSN/SAC, tax rate, taxable value and total amount, then download the GST invoice PDF using an online invoice generator."}},{"@type":"Question","name":"Who needs a GST invoice?","acceptedAnswer":{"@type":"Answer","text":"GST registered freelancers, consultants, contractors, agencies, product sellers, service providers and small businesses need GST invoices when they supply taxable goods or services."}},{"@type":"Question","name":"What is GST invoice format?","acceptedAnswer":{"@type":"Answer","text":"GST invoice format is the structure of a GST tax invoice, including supplier details, buyer details, invoice number, date, GSTIN, HSN/SAC, taxable value, CGST/SGST or IGST and total amount."}},{"@type":"Question","name":"Can freelancers create GST invoices?","acceptedAnswer":{"@type":"Answer","text":"Yes. GST registered freelancers can create GST invoices for taxable services such as design, development, consulting, writing, marketing and retainers."}},{"@type":"Question","name":"Can contractors create GST invoices?","acceptedAnswer":{"@type":"Answer","text":"Yes. Contractors can create GST invoices for labor, material, milestones, repair work and service jobs when GST applies."}},{"@type":"Question","name":"What is GSTIN in a GST invoice?","acceptedAnswer":{"@type":"Answer","text":"GSTIN is the Goods and Services Tax Identification Number. A GST invoice should show supplier GSTIN and, for B2B invoices, customer GSTIN when available."}},{"@type":"Question","name":"Is customer GSTIN mandatory?","acceptedAnswer":{"@type":"Answer","text":"Customer GSTIN is important for B2B GST invoices where the buyer wants input tax credit. For B2C transactions, customer GSTIN may not always apply."}},{"@type":"Question","name":"What is HSN code?","acceptedAnswer":{"@type":"Answer","text":"HSN code is a classification code used for goods under GST. It helps identify the product category and relevant tax treatment."}},{"@type":"Question","name":"What is SAC code?","acceptedAnswer":{"@type":"Answer","text":"SAC code is a service classification code used for services under GST."}},{"@type":"Question","name":"What is place of supply?","acceptedAnswer":{"@type":"Answer","text":"Place of supply helps decide whether a transaction is intra-state or inter-state, which affects whether CGST/SGST or IGST applies."}},{"@type":"Question","name":"What is taxable value?","acceptedAnswer":{"@type":"Answer","text":"Taxable value is the amount on which GST is calculated, generally after eligible discounts and before GST is added."}},{"@type":"Question","name":"What is CGST?","acceptedAnswer":{"@type":"Answer","text":"CGST is Central GST. It is generally charged along with SGST for intra-state supplies."}},{"@type":"Question","name":"What is SGST?","acceptedAnswer":{"@type":"Answer","text":"SGST is State GST. It is generally charged along with CGST for supplies within the same state."}},{"@type":"Question","name":"What is IGST?","acceptedAnswer":{"@type":"Answer","text":"IGST is Integrated GST. It is generally charged for inter-state supplies where seller and buyer are in different states."}},{"@type":"Question","name":"How do I calculate GST amount?","acceptedAnswer":{"@type":"Answer","text":"GST Amount = Taxable Value x GST Rate / 100. For example, Rs. 10,000 at 18% GST gives Rs. 1,800 GST."}},{"@type":"Question","name":"Can I download GST invoice PDF?","acceptedAnswer":{"@type":"Answer","text":"Yes. With InvoiceWala, you can create a GST invoice online and download a professional PDF after signup or login."}},{"@type":"Question","name":"Can I use GST invoice template in Excel?","acceptedAnswer":{"@type":"Answer","text":"Yes, but Excel requires manual formulas and formatting. Online GST invoice generators reduce calculation and PDF layout mistakes."}},{"@type":"Question","name":"What is a GST invoice generator?","acceptedAnswer":{"@type":"Answer","text":"A GST invoice generator is an online tool that creates GST invoices with tax fields, item rows, totals, PDF templates and invoice numbers."}},{"@type":"Question","name":"What are common GST rates?","acceptedAnswer":{"@type":"Answer","text":"Common GST rates include 0%, 5%, 12%, 18% and 28%. The correct rate depends on the goods or services supplied."}},{"@type":"Question","name":"Should GST invoice include invoice number?","acceptedAnswer":{"@type":"Answer","text":"Yes. A unique invoice number is important for GST invoice records and payment tracking."}},{"@type":"Question","name":"Can invoice numbers repeat?","acceptedAnswer":{"@type":"Answer","text":"Invoice numbers should not repeat within the same series or financial year."}},{"@type":"Question","name":"What is GST bill format?","acceptedAnswer":{"@type":"Answer","text":"GST bill format is another common phrase for GST invoice format or tax invoice format used by Indian businesses."}},{"@type":"Question","name":"Can I create GST invoice from quotation?","acceptedAnswer":{"@type":"Answer","text":"Yes. A quotation can be converted into a GST invoice when the customer approves the work or sale."}},{"@type":"Question","name":"Is InvoiceWala useful for GST invoices?","acceptedAnswer":{"@type":"Answer","text":"Yes. InvoiceWala helps create GST-ready invoices, calculate totals, generate invoice numbers and download professional PDF invoices."}}]}]0:{"rsc":["$","$1","c",{"children":[["$","main",null,{"className":"min-h-screen bg-slate-950 text-white","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],"$L3","$L4"]}],["$L5"],"$L6"]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"YJYk_eqd69nscZgMfKLxX"}
