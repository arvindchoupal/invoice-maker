{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/(app)/layout,_N_T_/(app)/recurring/layout,_N_T_/(app)/recurring/page,_N_T_/recurring"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/!KGFwcCk/recurring/__PAGE__",
    "/!KGFwcCk/recurring",
    "/!KGFwcCk",
    "/_index",
    "/_head"
  ]
}