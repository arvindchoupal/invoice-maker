5:Ted7,[{"@context":"https://schema.org","@type":"WebApplication","name":"GST calculator India","url":"https://invoicewala.shop/tools/gst-calculator","applicationCategory":"BusinessApplication","operatingSystem":"Web","offers":{"@type":"Offer","price":"0","priceCurrency":"INR"},"description":"Free GST calculator for India. Calculate inclusive or exclusive GST, split CGST/SGST or IGST, share results, download a breakdown and create GST invoices on InvoiceWala.","provider":{"@type":"Organization","name":"InvoiceWala","url":"https://invoicewala.shop"}},{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What is a GST calculator?","acceptedAnswer":{"@type":"Answer","text":"A GST calculator is an online tool that calculates GST amount, taxable value and final price based on an amount and GST rate."}},{"@type":"Question","name":"How do I calculate GST online?","acceptedAnswer":{"@type":"Answer","text":"Enter the amount, choose the GST rate and select whether the amount is GST-inclusive or GST-exclusive. The calculator shows taxable value, GST and total."}},{"@type":"Question","name":"What is GST-inclusive pricing?","acceptedAnswer":{"@type":"Answer","text":"GST-inclusive pricing means the final price already includes GST. The calculator separates the taxable value and GST amount from that total."}},{"@type":"Question","name":"What is GST-exclusive pricing?","acceptedAnswer":{"@type":"Answer","text":"GST-exclusive pricing means GST is added on top of the base amount. For example, Rs. 10,000 plus 18% GST becomes Rs. 11,800."}},{"@type":"Question","name":"Can I use this GST calculator for invoices?","acceptedAnswer":{"@type":"Answer","text":"Yes. You can use the GST amount while creating invoices, GST bills, quotations or PDF invoices."}},{"@type":"Question","name":"What GST rates are commonly used in India?","acceptedAnswer":{"@type":"Answer","text":"Common GST rates include 0%, 3%, 5%, 12%, 18% and 28%. The correct rate depends on the product or service category."}},{"@type":"Question","name":"Does this calculator support CGST, SGST and IGST?","acceptedAnswer":{"@type":"Answer","text":"Yes. InvoiceWala's GST calculator can show CGST and SGST split for intra-state supply or IGST for inter-state supply."}},{"@type":"Question","name":"Is this GST calculator free?","acceptedAnswer":{"@type":"Answer","text":"Yes. InvoiceWala's GST calculator is free to use online."}},{"@type":"Question","name":"Who should use a GST calculator?","acceptedAnswer":{"@type":"Answer","text":"Freelancers, consultants, agencies, contractors, shops, manufacturers and GST-registered small businesses can use it for quick tax checks."}},{"@type":"Question","name":"Can I create a GST invoice after calculating GST?","acceptedAnswer":{"@type":"Answer","text":"Yes. After calculating GST, you can use InvoiceWala's invoice generator or GST invoice maker to create a professional PDF invoice."}}]},{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://invoicewala.shop"},{"@type":"ListItem","position":2,"name":"Tools","item":"https://invoicewala.shop/tools"},{"@type":"ListItem","position":3,"name":"GST Calculator","item":"https://invoicewala.shop/tools/gst-calculator"}]},{"@context":"https://schema.org","@type":"HowTo","name":"How to calculate GST online","step":[{"@type":"HowToStep","name":"Enter the amount you want to calculate GST on."},{"@type":"HowToStep","name":"Choose the GST rate and inclusive or exclusive mode."},{"@type":"HowToStep","name":"Select CGST plus SGST or IGST based on supply type."},{"@type":"HowToStep","name":"Review taxable value, GST amount and final total."},{"@type":"HowToStep","name":"Use the result to create a GST-ready invoice."}]}]0:{"P":null,"c":["","tools","gst-calculator"],"q":"","i":false,"f":[[["",{"children":["tools",{"children":["gst-calculator",{"children":["__PAGE__",{}]}]}]},"$undefined","$undefined",16],[["$","