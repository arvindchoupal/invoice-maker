2:Ta81,[{"@context":"https://schema.org","@type":"WebApplication","name":"HSN and SAC code finder","url":"https://invoicewala.shop/tools/hsn-code-finder","applicationCategory":"BusinessApplication","operatingSystem":"Web","offers":{"@type":"Offer","price":"0","priceCurrency":"INR"},"description":"Free HSN code finder and SAC code search for India. Find common goods and service classification codes by product, profession, category and indicative GST rate.","provider":{"@type":"Organization","name":"InvoiceWala","url":"https://invoicewala.shop"}},{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What is an HSN code?","acceptedAnswer":{"@type":"Answer","text":"HSN is a classification system used for goods. Indian GST invoices commonly use HSN codes to identify the goods being supplied."}},{"@type":"Question","name":"What is a SAC code?","acceptedAnswer":{"@type":"Answer","text":"SAC means Services Accounting Code and is used to classify services such as consulting, software development, repair and advertising."}},{"@type":"Question","name":"Can I search by product or service name?","acceptedAnswer":{"@type":"Answer","text":"Yes. Search by code, common product name, service name, profession or keyword."}},{"@type":"Question","name":"Are GST rates in this tool final?","acceptedAnswer":{"@type":"Answer","text":"No. Rates are indicative because classification, notifications, packaging, value and transaction details can change the applicable rate. Verify on the official GST or CBIC portal or with a tax professional."}},{"@type":"Question","name":"Can I use the result on an invoice?","acceptedAnswer":{"@type":"Answer","text":"You can copy the code and use it while preparing an invoice, but confirm that the classification fits the exact product or service."}}]},{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://invoicewala.shop"},{"@type":"ListIt