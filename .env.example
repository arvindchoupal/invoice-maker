# The frontend uses the live API in development and production (see lib/api.ts).
NEXT_PUBLIC_API_URL=https://api.invoicewala.shop/api
# Public OAuth web client ID; must be available during npm run build, not only at runtime.
# For Docker builds, also pass --build-arg NEXT_PUBLIC_GOOGLE_CLIENT_ID=...
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
