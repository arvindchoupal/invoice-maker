# Local dev. Production uses https://api.invoicewala.shop/api (see lib/api.ts).
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Public OAuth web client ID; must be available during npm run build, not only at runtime.
# For Docker builds, also pass --build-arg NEXT_PUBLIC_GOOGLE_CLIENT_ID=...
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
